<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rejunte"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Ladrilho da marca: nome, conexão e tema -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ladrilho_marca"
            android:gravity="center_vertical"
            android:minHeight="96dp"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="8dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="Detector de Gases"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/txtConexao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="?attr/marca_clara"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnTema"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mudar o tema"
                android:src="@drawable/ic_tema" />
        </LinearLayout>

        <!-- Ladrilho de estado: o que está acontecendo e o que fazer -->
        <LinearLayout
            android:id="@+id/ladrilhoEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:minHeight="248dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="22dp">

            <ImageView
                android:id="@+id/icEstado"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/txtEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="assertive"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:letterSpacing="-0.01"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMensagem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3sp"
                android:maxWidth="320dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtAtualizado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFeatureSettings="tnum"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnConectar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/botao_marca"
                android:fontFamily="sans-serif-medium"
                android:minHeight="52dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:stateListAnimator="@null"
                android:text="Conectar ao detector"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Grade 2x2: os três sensores e o ladrilho pintado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <include android:id="@+id/sensorMq2" layout="@layout/ladrilho_sensor"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <View android:layout_width="4dp" android:layout_height="0dp" />

            <include android:id="@+id/sensorMq135" layout="@layout/ladrilho_sensor"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <include android:id="@+id/sensorTemp" layout="@layout/ladrilho_sensor"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />

            <View android:layout_width="4dp" android:layout_height="0dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ladrilho">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/azulejo_motivo" />
            </FrameLayout>
        </LinearLayout>

        <!-- Barra da última hora -->
        <LinearLayout style="@style/Ladrilho">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true">

                <TextView
                    style="@style/Texto.Titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="Como esteve o ar" />

                <TextView
                    android:id="@+id/txtPeriodo"
                    style="@style/Texto.Tecnico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.pi3.detector.BarraEstados
                android:id="@+id/barra"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="noHideDescendants">

                <TextView
                    android:id="@+id/txtInicio"
                    style="@style/Texto.Tecnico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txtFim"
                    style="@style/Texto.Tecnico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="agora" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtTempoEstados"
                style="@style/Texto.Corpo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <!-- Resumo da sessão -->
        <LinearLayout style="@style/Ladrilho">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true">

                <TextView
                    style="@style/Texto.Titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="Resumo da sessão" />

                <TextView
                    android:id="@+id/txtLeituras"
                    style="@style/Texto.Tecnico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textSize="13sp" />
            </LinearLayout>

            <TableLayout
                android:id="@+id/tabela"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shrinkColumns="0"
                android:stretchColumns="0" />
        </LinearLayout>

        <include android:id="@+id/graficoMq2" layout="@layout/ladrilho_grafico" />

        <include android:id="@+id/graficoMq135" layout="@layout/ladrilho_grafico" />

        <include android:id="@+id/graficoTemp" layout="@layout/ladrilho_grafico" />

        <Button
            android:id="@+id/btnDesconectar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/ladrilho_botao"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="Desconectar"
            android:textAllCaps="false"
            android:textColor="?attr/acao"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>

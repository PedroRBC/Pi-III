<?xml version="1.0" encoding="utf-8"?>
<!-- Linha do seletor de detector: nome em destaque, endereço como detalhe técnico -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp"
    android:paddingBottom="10dp">

    <TextView android:id="@+id/nome" style="@style/Texto.Titulo"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <TextView android:id="@+id/detalhe" style="@style/Texto.Tecnico"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="13sp" />
</LinearLayout>

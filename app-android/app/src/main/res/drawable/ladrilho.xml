<?xml version="1.0" encoding="utf-8"?>
<!-- Ladrilho vitrificado: face lisa com um filete de esmalte mais escuro na base -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><solid android:color="@color/esmalte_base" /><corners android:radius="3dp" /></shape>
    </item>
    <item android:bottom="2dp">
        <shape><solid android:color="@color/azulejo" /><corners android:radius="3dp" /></shape>
    </item>
</layer-list>
